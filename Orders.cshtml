@model IEnumerable<ShoeShop.Models.Order>
@{
    ViewData["Title"] = "Order Management - Admin Portal";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <h1 class="h3 fw-bold mb-0">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i> Admin Order Management
            </h1>
            <small class="text-muted">Process, update status, and manage cancellations across all customer shoe purchases</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard Overview
            </a>
            <a asp-controller="Shoes" asp-action="Index" class="btn btn-dark btn-sm">
                <i class="bi bi-grid me-1"></i> Shoe Catalog
            </a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <div>
                <h5 class="fw-bold mb-0">All Customer Orders (@Model.Count() total)</h5>
                <small class="text-muted">Real-time database records and fulfillment controls</small>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="bi bi-shield-check text-success me-1"></i> Admin Authorized
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <div class="fs-1 text-muted mb-2">🛒</div>
                <h5 class="fw-bold">No Customer Orders Yet</h5>
                <p class="text-muted mb-0">Customer orders will appear here automatically as soon as checkouts occur.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Order #</th>
                            <th>Customer & Shipping</th>
                            <th>Products Purchased</th>
                            <th>Total & Method</th>
                            <th>Current Status</th>
                            <th class="text-end" style="min-width: 260px;">Admin Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var statusBadgeClass = order.Status switch
                            {
                                var s when s.Contains("Cancelled", StringComparison.OrdinalIgnoreCase) => "bg-danger text-white",     // Red for Cancelled
                                var s when s.Contains("Shipped", StringComparison.OrdinalIgnoreCase) => "bg-success text-white",        // Green for Shipped
                                var s when s.Contains("Delivered", StringComparison.OrdinalIgnoreCase) => "bg-success text-white",      // Green for Delivered
                                var s when s.Contains("Processing", StringComparison.OrdinalIgnoreCase) => "bg-primary text-white",     // Blue for Processing
                                var s when s.Contains("Pending", StringComparison.OrdinalIgnoreCase) => "bg-warning text-dark",         // Yellow for Pending
                                var s when s.Contains("Paid", StringComparison.OrdinalIgnoreCase) => "bg-success text-white",          // Green for Paid
                                _ => "bg-secondary text-white"
                            };

                            var paymentBadge = order.PaymentMethod switch
                            {
                                "COD" => "💵 COD",
                                "PayPal" => "🅿️ PayPal",
                                "QRCode" => "📱 QR Code",
                                _ => order.PaymentMethod
                            };

                            <tr>
                                <!-- Order # & Date -->
                                <td>
                                    <span class="fw-bold font-monospace bg-light border px-2 py-1 rounded d-block mb-1">
                                        @order.OrderNumber
                                    </span>
                                    <small class="text-muted">@order.CreatedAt.ToString("MMM dd, yyyy")</small><br />
                                    <small class="text-muted">@order.CreatedAt.ToString("h:mm tt")</small>
                                </td>

                                <!-- Customer Details -->
                                <td>
                                    <div class="fw-bold">@order.CustomerName</div>
                                    <small class="text-muted d-block"><i class="bi bi-envelope me-1"></i>@order.CustomerEmail</small>
                                    <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i>@order.CustomerPhone</small>
                                    <small class="text-secondary d-block mt-1" style="max-width: 250px;">
                                        <i class="bi bi-geo-alt me-1"></i>@order.ShippingAddress
                                    </small>
                                </td>

                                <!-- Products Purchased -->
                                <td>
                                    <ul class="list-unstyled mb-0" style="min-width: 220px;">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li class="d-flex align-items-center mb-1">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=80&q=80" : item.ImageUrl)"
                                                     alt="@item.ShoeName"
                                                     class="rounded me-2 object-fit-cover shadow-sm"
                                                     style="width: 36px; height: 36px;" />
                                                <div class="small">
                                                    <strong>@item.ShoeName</strong><br />
                                                    <span class="text-muted">Size: @item.Size | Qty: <strong>@item.Quantity</strong> × $@item.UnitPrice.ToString("F2")</span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </td>

                                <!-- Total & Payment -->
                                <td>
                                    <div class="fw-bold text-success fs-6">$@order.TotalAmount.ToString("F2")</div>
                                    <span class="badge bg-light text-dark border mt-1">@paymentBadge</span>
                                </td>

                                <!-- Status Badge & Reason -->
                                <td>
                                    <span class="badge @statusBadgeClass px-3 py-2 rounded-pill">
                                        @order.Status
                                    </span>
                                    @if (!string.IsNullOrEmpty(order.CancellationReason))
                                    {
                                        <div class="mt-2 small text-danger" style="max-width: 200px;">
                                            <i class="bi bi-info-circle-fill me-1"></i><strong>Reason:</strong> @order.CancellationReason
                                        </div>
                                    }
                                </td>

                                <!-- Actions: Status Update & Admin Cancellation Modal Trigger -->
                                <td class="text-end">
                                    <div class="d-flex flex-column gap-2 align-items-end">
                                        <!-- Status Update Form -->
                                        <form asp-controller="AdminDashboard" asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <select name="newStatus" class="form-select form-select-sm" style="width: 140px;">
                                                <option value="Processing" selected="@(order.Status == "Processing")">Processing</option>
                                                <option value="Shipped" selected="@(order.Status == "Shipped")">Shipped</option>
                                                <option value="Delivered" selected="@(order.Status == "Delivered")">Delivered</option>
                                                <option value="Paid via PayPal" selected="@(order.Status == "Paid via PayPal")">Paid - PayPal</option>
                                                <option value="Paid via QR Code" selected="@(order.Status == "Paid via QR Code")">Paid - QR Code</option>
                                                <option value="Pending - Cash on Delivery" selected="@(order.Status == "Pending - Cash on Delivery")">Pending - COD</option>
                                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                            </select>
                                            <button type="submit" class="btn btn-outline-primary btn-sm px-2" title="Save status">
                                                Update
                                            </button>
                                        </form>

                                        <!-- Action Buttons: Details & Cancel -->
                                        <div class="d-flex gap-2 align-items-center">
                                            <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm" title="View complete order breakdown">
                                                <i class="bi bi-eye me-1"></i> Details
                                            </a>

                                            @if (order.Status != "Cancelled")
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#adminCancelModal-@order.Id">
                                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                                    <i class="bi bi-slash-circle me-1"></i> Cancelled
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Admin Cancellation Bootstrap Modal -->
                                    <div class="modal fade" id="adminCancelModal-@order.Id" tabindex="-1" aria-labelledby="modalLabel-@order.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <form asp-controller="AdminDashboard" asp-action="AdminCancelOrder" method="post" class="text-start">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@order.Id" />

                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title fw-bold" id="modalLabel-@order.Id">
                                                            <i class="bi bi-exclamation-octagon-fill me-2"></i> Cancel Order #@order.OrderNumber
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>

                                                    <div class="modal-body p-4">
                                                        <p class="mb-2">
                                                            Are you sure you want to cancel order <strong>#@order.OrderNumber</strong> for customer <strong>@order.CustomerName</strong>?
                                                        </p>
                                                        <div class="alert alert-warning small mb-3">
                                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                            <strong>Inventory restoration:</strong> Cancelling this order will immediately add back 
                                                            <strong>@order.OrderItems.Sum(i => i.Quantity)</strong> shoe item(s) to the store catalog stock.
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Select Cancellation Reason:</label>
                                                            <select id="reasonPreset-@order.Id" class="form-select mb-2" onchange="document.getElementById('reasonInput-@order.Id').value = this.value;">
                                                                <option value="Out of Stock">Out of Stock</option>
                                                                <option value="Fake Order">Fake Order</option>
                                                                <option value="Payment Not Received">Payment Not Received</option>
                                                                <option value="Customer Requested Cancellation">Customer Requested Cancellation</option>
                                                                <option value="Duplicate Order">Duplicate Order</option>
                                                                <option value="Fraudulent Activity Detected">Fraudulent Activity Detected</option>
                                                            </select>
                                                        </div>

                                                        <div class="mb-2">
                                                            <label class="form-label fw-bold">Cancellation Reason Note (Saved to Database):</label>
                                                            <input type="text" 
                                                                   id="reasonInput-@order.Id" 
                                                                   name="cancellationReason" 
                                                                   class="form-control" 
                                                                   value="Out of Stock" 
                                                                   placeholder="Type or select a cancellation reason..." 
                                                                   required />
                                                            <small class="text-muted">You can edit or type a custom reason above.</small>
                                                        </div>
                                                    </div>

                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                        <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
                                                            <i class="bi bi-x-circle me-1"></i> Confirm Cancel
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

