@{
    ViewData["Title"] = "Reset Email Sent";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="display-5 text-success mb-3">✓</div>
            <h3 class="fw-bold">Check Your Email</h3>
            <p class="text-muted">
                If an account exists with the email you entered, we have sent instructions to reset your password.
                (During local development, check your terminal logs to find the link).
            </p>
            <a asp-action="Login" class="btn btn-dark mt-3">Return to Sign In</a>
        </div>
    </div>
</div>
