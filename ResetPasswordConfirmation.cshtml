@{
    ViewData["Title"] = "Password Updated";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="display-5 text-success mb-3">✓</div>
            <h3 class="fw-bold">Password Reset Complete</h3>
            <p class="text-muted">Your password has been reset successfully. You can now log in using your new credentials.</p>
            <a asp-action="Login" class="btn btn-dark mt-3">Sign In Now</a>
        </div>
    </div>
</div>
