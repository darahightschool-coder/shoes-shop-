@model ShoeShop.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <span class="badge bg-dark px-3 py-2 text-uppercase mb-2">Join Shoe Shop</span>
                    <h2 class="fw-bold">Create Your Account</h2>
                    <p class="text-muted small">Exclusive sneaker drops, order tracking, and fast checkout.</p>
                </div>

                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center mb-3 rounded-3" role="alert">
                        <i class="bi bi-person-plus-fill me-2 fs-5 flex-shrink-0 text-warning-emphasis"></i>
                        <span><strong>Account required to checkout:</strong> Create an account below to complete your order and track your purchases.</span>
                    </div>
                }

                <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Jane Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold mt-4 mb-2 text-muted text-uppercase small">Shipping Details (Optional)</h6>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" placeholder="123 Sneaker Boulevard" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-sm-7">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="New York" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="10001" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">Register Account</button>
                </form>

                <hr class="my-4" />
                <div class="text-center small">
                    <span class="text-muted">Already have an account?</span>
                    <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-decoration-none fw-semibold">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
