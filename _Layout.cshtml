@using ShoeShop.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shoe Shop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 me-2">👟</span> Shoe Shop
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Shoes" asp-action="Index">Shoes Catalog</a>
                        </li>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="AdminDashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Admin Portal
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold" asp-controller="AdminDashboard" asp-action="Orders">
                                    <i class="bi bi-receipt-cutoff me-1"></i> Manage Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-info fw-semibold" asp-controller="Shoes" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill me-1"></i> Add Product
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <!-- Shopping Cart with Dynamic Session Badge -->
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light position-relative btn-sm px-3 d-flex align-items-center" asp-controller="Cart" asp-action="Index" title="Shopping Cart">
                                <i class="bi bi-cart me-1"></i>
                                <span>Cart</span>
                                <span class="badge bg-danger rounded-pill ms-2">
                                    @(Context.Session.GetInt32("CartCount") ?? 0)
                                </span>
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- User Avatar & Profile Dropdown -->
                            <li class="nav-item dropdown ms-2">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-1 pe-2 rounded-pill bg-dark-subtle border border-secondary border-opacity-50 text-white" 
                                   href="#" 
                                   id="userDropdown" 
                                   role="button" 
                                   data-bs-toggle="dropdown" 
                                   aria-expanded="false">
                                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle fw-bold shadow-sm" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    <span class="d-none d-md-inline fw-semibold small pe-1">
                                        @(User.Identity?.Name?.Split('@')[0] ?? "My Profile")
                                    </span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-3 border-0 py-2 mt-2" aria-labelledby="userDropdown" style="min-width: 220px;">
                                    <!-- User Details Header -->
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark small text-truncate">@User.Identity?.Name</div>
                                        <div class="text-muted small">
                                            @(User.IsInRole(Roles.Admin) ? "👑 Store Administrator" : "👟 Shoe Shop Customer")
                                        </div>
                                    </li>

                                    @if (User.IsInRole(Roles.Admin))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-danger fw-semibold" asp-controller="AdminDashboard" asp-action="Index">
                                                <i class="bi bi-shield-lock-fill me-2"></i> Admin Portal
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-success fw-semibold" asp-controller="Shoes" asp-action="Create">
                                                <i class="bi bi-plus-circle-fill me-2"></i> Add New Product
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }

                                    <!-- Customer Dashboard & Orders Links -->
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-dark" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i> Customer Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-dark" asp-controller="Orders" asp-action="Index">
                                            <i class="bi bi-bag-check me-2 text-success"></i> My Shoe Orders
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider my-1"></li>

                                    <!-- Sign Out Action -->
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 flex-grow-1">
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["StatusMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-muted mt-auto">
        <div class="container text-center small">
            &copy; 2026 Shoe Shop - ASP.NET Core MVC E-Commerce Application.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
