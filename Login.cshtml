@model ShoeShop.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Welcome Back</h2>
                    <p class="text-muted small">Sign in to manage your orders & profile</p>
                </div>

                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center mb-3 rounded-3" role="alert">
                        <i class="bi bi-shield-lock-fill me-2 fs-5 flex-shrink-0 text-warning-emphasis"></i>
                        <span><strong>Sign in required:</strong> Please log in to complete your checkout and place your order.</span>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold mb-0"></label>
                            <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                        </div>
                        <input asp-for="Password" class="form-control mt-1" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">Sign In</button>
                </form>

                <hr class="my-4" />
                <div class="text-center small">
                    <span class="text-muted">Don't have an account?</span>
                    <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="text-decoration-none fw-semibold">Create one</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
