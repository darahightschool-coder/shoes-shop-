@model ShoeShop.Models.Shoe
@{
    ViewData["Title"] = "Add New Shoe";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle-fill text-success me-2"></i>Add New Product</h4>
                    <small class="text-light opacity-75">Add a new shoe to the store catalog & inventory</small>
                </div>
                <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Admin Portal
                </a>
            </div>

            <div class="card-body p-4 p-sm-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <!-- Brand -->
                        <div class="col-sm-6">
                            <label asp-for="Brand" class="form-label fw-semibold">Brand / Manufacturer</label>
                            <input asp-for="Brand" class="form-control" placeholder="e.g. Nike, Adidas, Jordan, Puma" autofocus />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <!-- Price -->
                        <div class="col-sm-6">
                            <label asp-for="Price" class="form-label fw-semibold">Price (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control" placeholder="180.00" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Shoe Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Shoe / Model Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Air Jordan 1 Retro High OG" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Category -->
                        <div class="col-sm-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Lifestyle">Lifestyle</option>
                                <option value="Running">Running</option>
                                <option value="Basketball">Basketball</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <!-- Color -->
                        <div class="col-sm-6">
                            <label asp-for="Color" class="form-label fw-semibold">Primary Colorway</label>
                            <select asp-for="Color" class="form-select">
                                <option value="Black">Black</option>
                                <option value="White">White</option>
                                <option value="Red">Red</option>
                                <option value="Blue">Blue</option>
                                <option value="Grey">Grey</option>
                                <option value="Green">Green</option>
                            </select>
                            <span asp-validation-for="Color" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Product Image URL</label>
                        <input asp-for="ImageUrl" id="shoeImageUrlInput" class="form-control" placeholder="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        <div class="form-text small">Provide a direct high-res image link (Unsplash, CDN, or web URL).</div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> Save Product
                        </button>
                        <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
