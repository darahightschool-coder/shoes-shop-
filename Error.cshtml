@model ShoeShop.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card border-danger my-5 p-4 text-center">
    <h1 class="text-danger fw-bold">Error</h1>
    <h2 class="text-secondary">An error occurred while processing your request.</h2>
    @if (Model.ShowRequestId)
    {
        <p class="mt-3">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
